#!/bin/bash
# fileview — Open/refresh files as styled HTML in an iTerm2 browser split pane.
# Supports multiple files as tabs within the same pane.
#
# Usage:
#   fileview open <file> [file2] ...  — Add file(s) as tabs, open/reuse browser split
#   fileview close                    — Close the browser split pane + clear all tabs
#   fileview close <file>             — Remove a specific tab
#   fileview list                     — List current tabs

set -e

# Resolve script directory (follows symlinks)
_FV_ENTRYPOINT="$0"
SCRIPT_DIR="$(cd "$(dirname "$(realpath "$0")")" && pwd)"

# Source libraries
# shellcheck source=lib/config.sh
source "$SCRIPT_DIR/lib/config.sh"
# shellcheck source=lib/paths.sh
source "$SCRIPT_DIR/lib/paths.sh"
# shellcheck source=lib/filetypes.sh
source "$SCRIPT_DIR/lib/filetypes.sh"
# shellcheck source=lib/diff.sh
source "$SCRIPT_DIR/lib/diff.sh"
# shellcheck source=lib/render.sh
source "$SCRIPT_DIR/lib/render.sh"
# shellcheck source=lib/server.sh
source "$SCRIPT_DIR/lib/server.sh"
# shellcheck source=lib/watcher.sh
source "$SCRIPT_DIR/lib/watcher.sh"
# shellcheck source=lib/iterm.sh
source "$SCRIPT_DIR/lib/iterm.sh"

# Copy template to cache if not present
if [ ! -f "$VIEW_TEMPLATE" ]; then
  cp "$SCRIPT_DIR/templates/viewer.html" "$VIEW_TEMPLATE"
fi

# --- CLI Commands ---

cmd_open() {
  if [ $# -eq 0 ]; then
    echo "Usage: fileview open <file> [file2] ..." >&2
    return 1
  fi

  _show_loading
  touch "$TABS_FILE"

  local last_file=""
  for src_file in "$@"; do
    local abs_path
    abs_path=$(_resolve_path "$src_file")
    if [ ! -f "$abs_path" ]; then
      echo "fileview: file not found: $src_file" >&2
      continue
    fi
    # Add to tabs if not already present
    if ! grep -qxF "$abs_path" "$TABS_FILE" 2>/dev/null; then
      echo "$abs_path" >> "$TABS_FILE"
    fi
    last_file="$abs_path"
    # Track plan files per-session for fileview-plan shortcut
    case "$abs_path" in
      */.claude/plans/*.md) echo "$abs_path" > "$_FV_SESSION_DIR/plan" ;;
    esac
  done

  if [ -z "$last_file" ]; then
    return 1
  fi

  # Set the last file as active
  echo "$last_file" > "$ACTIVE_FILE"

  if ! generate_tabbed_html; then
    return 1
  fi
  start_watcher
  start_server
  _open_or_reuse_pane
}

cmd_close() {
  if [ $# -eq 0 ]; then
    stop_watcher
    stop_server
    rm -f "$TABS_FILE" "$ACTIVE_FILE"
    rm -f "$_FV_SESSION_DIR/plan" "$_FV_SESSION_DIR/mode"
    _close_fileview_pane
    return 0
  fi

  # Remove a specific tab
  local target
  target=$(_resolve_path "$1")

  if [ ! -f "$TABS_FILE" ]; then
    return 0
  fi

  local tmp
  tmp=$(mktemp)
  grep -vxF "$target" "$TABS_FILE" > "$tmp" || true
  mv "$tmp" "$TABS_FILE"

  # If no tabs left, close everything
  if [ ! -s "$TABS_FILE" ]; then
    stop_watcher
    stop_server
    rm -f "$TABS_FILE" "$ACTIVE_FILE"
    rm -f "$_FV_SESSION_DIR/plan"
    _close_fileview_pane
    return 0
  fi

  # If the closed tab was active, activate the last remaining tab
  local current_active
  current_active=$(cat "$ACTIVE_FILE" 2>/dev/null)
  if [ "$current_active" = "$target" ]; then
    tail -1 "$TABS_FILE" > "$ACTIVE_FILE"
  fi

  generate_tabbed_html
  start_watcher
}

cmd_diff() {
  local files
  files=$({ git diff --name-only; git diff --name-only --cached; git ls-files --others --exclude-standard; } 2>/dev/null | sort -u)
  if [ -z "$files" ]; then
    echo "fileview: no git changes found" >&2
    return 1
  fi
  _show_loading
  # Set diff mode so generate_file_body adds diff data attributes
  echo "diff" > "$_FV_SESSION_DIR/mode"
  # Append changed files to existing tabs (preserves plan file etc.)
  touch "$TABS_FILE"
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    local abs_path
    abs_path=$(_resolve_path "$f")
    [ ! -f "$abs_path" ] && continue
    if ! grep -qxF "$abs_path" "$TABS_FILE" 2>/dev/null; then
      echo "$abs_path" >> "$TABS_FILE"
    fi
  done <<< "$files"
  if [ ! -s "$TABS_FILE" ]; then
    rm -f "$_FV_SESSION_DIR/mode"
    return 1
  fi
  # Keep existing active file; if none set, use the first tab
  if [ ! -f "$ACTIVE_FILE" ] || [ ! -s "$ACTIVE_FILE" ]; then
    head -1 "$TABS_FILE" > "$ACTIVE_FILE"
  fi
  if ! generate_tabbed_html; then
    rm -f "$_FV_SESSION_DIR/mode"
    return 1
  fi
  start_watcher
  start_server
  _open_or_reuse_pane
}

cmd_list() {
  if [ ! -f "$TABS_FILE" ] || [ ! -s "$TABS_FILE" ]; then
    echo "No tabs open."
    return 0
  fi
  local active_file=""
  if [ -f "$ACTIVE_FILE" ]; then
    active_file=$(cat "$ACTIVE_FILE")
  fi
  while IFS= read -r fp; do
    [ -z "$fp" ] && continue
    if [ "$fp" = "$active_file" ]; then
      echo "* $(basename "$fp")  ($fp)"
    else
      echo "  $(basename "$fp")  ($fp)"
    fi
  done < "$TABS_FILE"
}

# --- Dispatch ---

case "$1" in
  open)    shift; cmd_open "$@" ;;
  close)   shift; cmd_close "$@" ;;
  diff)    cmd_diff ;;
  list)    cmd_list ;;
  _regen)  generate_tabbed_html ;;
  *)       echo "Usage: fileview {open|close|diff|list} [file ...]" >&2; exit 1 ;;
esac
