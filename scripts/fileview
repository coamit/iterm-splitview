#!/bin/bash
# fileview — Open/refresh files as styled HTML in an iTerm2 browser split pane.
# Supports multiple files as tabs within the same pane.
#
# Usage:
#   fileview open <file> [file2] ...  — Add file(s) as tabs, open/reuse browser split
#   fileview close                    — Close the browser split pane + clear all tabs
#   fileview close <file>             — Remove a specific tab
#   fileview list                     — List current tabs

set -e

# Resolve script directory (follows symlinks)
_FV_ENTRYPOINT="$0"
SCRIPT_DIR="$(cd "$(dirname "$(realpath "$0")")" && pwd)"

# Source libraries
# shellcheck source=lib/config.sh
source "$SCRIPT_DIR/lib/config.sh"
# shellcheck source=lib/paths.sh
source "$SCRIPT_DIR/lib/paths.sh"
# shellcheck source=lib/filetypes.sh
source "$SCRIPT_DIR/lib/filetypes.sh"
# shellcheck source=lib/diff.sh
source "$SCRIPT_DIR/lib/diff.sh"
# shellcheck source=lib/render.sh
source "$SCRIPT_DIR/lib/render.sh"
# shellcheck source=lib/server.sh
source "$SCRIPT_DIR/lib/server.sh"
# shellcheck source=lib/watcher.sh
source "$SCRIPT_DIR/lib/watcher.sh"
# shellcheck source=lib/iterm.sh
source "$SCRIPT_DIR/lib/iterm.sh"

# Copy template to cache (always sync — source may have changed)
cp "$SCRIPT_DIR/templates/viewer.html" "$VIEW_TEMPLATE"

# --- GC: clean up stale sessions from dead iTerm tabs ---

_gc_stale_sessions() {
  local base="/tmp/fileview"
  [ -d "$base" ] || return 0
  for session_dir in "$base"/*/; do
    [ -d "$session_dir" ] || continue
    local name
    name=$(basename "$session_dir")
    [ "$name" = "$_FV_SESSION_ID" ] && continue  # skip our own session

    # Check if the session's watcher or server is still alive
    local has_live_process=false
    for pidfile in "$session_dir/watcher.pid" "$session_dir/server.pid"; do
      if [ -f "$pidfile" ]; then
        local pid
        pid=$(cat "$pidfile")
        if kill -0 "$pid" 2>/dev/null; then
          has_live_process=true
          break
        fi
      fi
    done
    $has_live_process || continue  # no processes → already dead, skip

    # Has live processes — check if the iTerm pane still exists
    local pane_id=""
    [ -f "$session_dir/pane_session_id" ] && pane_id=$(cat "$session_dir/pane_session_id")
    if [ -z "$pane_id" ]; then
      _gc_kill_session "$session_dir"
      continue
    fi

    local pane_exists
    pane_exists=$(osascript -e "
      tell application \"iTerm2\"
        repeat with w in windows
          repeat with t in tabs of w
            repeat with s in sessions of t
              if unique ID of s is \"$pane_id\" then return \"yes\"
            end repeat
          end repeat
        end repeat
        return \"no\"
      end tell" 2>/dev/null)

    if [ "$pane_exists" != "yes" ]; then
      _gc_kill_session "$session_dir"
    fi
  done
}

_gc_kill_session() {
  local session_dir="$1"
  for pidfile in "$session_dir/watcher.pid" "$session_dir/server.pid"; do
    if [ -f "$pidfile" ]; then
      local pid
      pid=$(cat "$pidfile")
      kill "$pid" 2>/dev/null || true
      rm -f "$pidfile"
    fi
  done
  rm -rf "$session_dir"
}

# Run GC in background on open/diff (non-blocking)
if [ "${1:-}" = "open" ] || [ "${1:-}" = "diff" ]; then
  _gc_stale_sessions &
fi

# --- Shared helpers ---

_close_all() {
  stop_watcher
  stop_server
  rm -f "$TABS_FILE" "$ACTIVE_FILE" "$CWD_FILE" "$SEARCH_ROOT_FILE" "$COLLAPSED_FILE"
  rm -f "$_FV_SESSION_DIR/plan" "$_FV_SESSION_DIR/mode"
  # Remove watched file and all per-repo git tab files
  rm -f "$WATCHED_FILE"
  rm -f "$_FV_SESSION_DIR"/tabs.git.*
  _close_fileview_pane
}

_add_file_to_tabs() {
  local abs_path="$1"
  if ! grep -qxF "$abs_path" "$TABS_FILE" 2>/dev/null; then
    echo "$abs_path" >> "$TABS_FILE"
  fi
}

_generate_and_launch() {
  if ! generate_tabbed_html; then
    return 1
  fi
  start_watcher
  start_server
  _open_or_reuse_pane
}

# --- CLI Commands ---

cmd_open() {
  _show_loading
  touch "$TABS_FILE"
  echo "$PWD" > "$CWD_FILE"

  if [ $# -eq 0 ]; then
    # No files — just open the pane with existing tabs (or empty)
    _generate_and_launch
    return
  fi

  local last_file=""
  for src_file in "$@"; do
    local abs_path
    abs_path=$(_resolve_path "$src_file")
    if [ ! -f "$abs_path" ]; then
      echo "fileview: file not found: $src_file" >&2
      continue
    fi
    # If the file is already in any git tab file, just activate it without duplicating
    local in_git_tabs=false
    for gtf in "$_FV_SESSION_DIR"/tabs.git.*; do
      [ -f "$gtf" ] || continue
      if grep -qxF "$abs_path" "$gtf" 2>/dev/null; then
        in_git_tabs=true
        break
      fi
    done
    if [ "$in_git_tabs" = false ]; then
      _add_file_to_tabs "$abs_path"
    fi
    last_file="$abs_path"
    case "$abs_path" in
      */.claude/plans/*.md) echo "$abs_path" > "$_FV_SESSION_DIR/plan" ;;
    esac
  done

  if [ -z "$last_file" ]; then
    return 1
  fi

  echo "$last_file" > "$ACTIVE_FILE"
  _generate_and_launch
}

cmd_close() {
  if [ $# -eq 0 ]; then
    _close_all
    return 0
  fi

  local target
  target=$(_resolve_path "$1")

  # Remove from files tab and all git tab files
  for tabfile in "$TABS_FILE" "$_FV_SESSION_DIR"/tabs.git.*; do
    [ -f "$tabfile" ] || continue
    local tmp
    tmp=$(mktemp)
    grep -vxF "$target" "$tabfile" > "$tmp" || true
    mv "$tmp" "$tabfile"
  done

  # If all tab files are empty, close all
  local any_has_tabs=false
  if [ -f "$TABS_FILE" ] && [ -s "$TABS_FILE" ]; then
    any_has_tabs=true
  fi
  if [ "$any_has_tabs" = false ]; then
    for gtf in "$_FV_SESSION_DIR"/tabs.git.*; do
      [ -f "$gtf" ] && [ -s "$gtf" ] && { any_has_tabs=true; break; }
    done
  fi
  if [ "$any_has_tabs" = false ]; then
    _close_all
    return 0
  fi

  local current_active
  current_active=$(cat "$ACTIVE_FILE" 2>/dev/null)
  if [ "$current_active" = "$target" ]; then
    # Pick new active from whichever tab file has content
    if [ -f "$TABS_FILE" ] && [ -s "$TABS_FILE" ]; then
      tail -1 "$TABS_FILE" > "$ACTIVE_FILE"
    else
      for gtf in "$_FV_SESSION_DIR"/tabs.git.*; do
        [ -f "$gtf" ] && [ -s "$gtf" ] && { tail -1 "$gtf" > "$ACTIVE_FILE"; break; }
      done
    fi
  fi

  generate_tabbed_html
  start_watcher
}

cmd_diff() {
  local target_dir="${1:-.}"
  local git_root
  git_root=$(git -C "$(_resolve_path "$target_dir")" rev-parse --show-toplevel 2>/dev/null)
  if [ -z "$git_root" ]; then
    echo "fileview: not a git repository: $target_dir" >&2
    return 1
  fi
  local repo_name
  repo_name=$(basename "$git_root")

  # Check if already watched
  if grep -qxF "$git_root" "$WATCHED_FILE" 2>/dev/null; then
    echo "fileview: already watching $repo_name"
    return 0
  fi

  # Add to watched list
  echo "$git_root" >> "$WATCHED_FILE"

  # Do initial sync of git changes for this repo
  local tabs_file
  tabs_file=$(_git_tabs_file "$repo_name")
  _sync_repo_tabs "$git_root" "$tabs_file"

  _show_loading
  echo "diff" > "$_FV_SESSION_DIR/mode"
  echo "$PWD" > "$CWD_FILE"

  # Set active to first file if none set
  if [ ! -f "$ACTIVE_FILE" ] || [ ! -s "$ACTIVE_FILE" ]; then
    [ -s "$tabs_file" ] && head -1 "$tabs_file" > "$ACTIVE_FILE"
  fi

  _generate_and_launch
}

cmd_unwatch() {
  local target_dir="${1:-.}"
  local git_root
  git_root=$(git -C "$(_resolve_path "$target_dir")" rev-parse --show-toplevel 2>/dev/null || _resolve_path "$target_dir")
  local repo_name
  repo_name=$(basename "$git_root")

  # Remove from watched
  if [ -f "$WATCHED_FILE" ]; then
    local tmp
    tmp=$(mktemp)
    grep -vxF "$git_root" "$WATCHED_FILE" > "$tmp" || true
    mv "$tmp" "$WATCHED_FILE"
  fi

  # Remove tabs file
  rm -f "$(_git_tabs_file "$repo_name")"

  generate_tabbed_html
  start_watcher
  echo "Stopped watching $repo_name"
}

cmd_list() {
  local has_any=false
  local active_file=""
  [ -f "$ACTIVE_FILE" ] && active_file=$(cat "$ACTIVE_FILE")

  if [ -f "$TABS_FILE" ] && [ -s "$TABS_FILE" ]; then
    has_any=true
    echo "Files:"
    while IFS= read -r fp; do
      [ -z "$fp" ] && continue
      if [ "$fp" = "$active_file" ]; then
        echo "* $(basename "$fp")  ($fp)"
      else
        echo "  $(basename "$fp")  ($fp)"
      fi
    done < "$TABS_FILE"
  fi

  # List each watched repo's git tabs
  if [ -f "$WATCHED_FILE" ] && [ -s "$WATCHED_FILE" ]; then
    while IFS= read -r repo_root; do
      [ -z "$repo_root" ] && continue
      local name
      name=$(basename "$repo_root")
      local tf
      tf=$(_git_tabs_file "$name")
      if [ -f "$tf" ] && [ -s "$tf" ]; then
        has_any=true
        echo "Git Changes ($name):"
        while IFS= read -r fp; do
          [ -z "$fp" ] && continue
          if [ "$fp" = "$active_file" ]; then
            echo "* $(basename "$fp")  ($fp)"
          else
            echo "  $(basename "$fp")  ($fp)"
          fi
        done < "$tf"
      fi
    done < "$WATCHED_FILE"
  fi

  if [ "$has_any" = false ]; then
    echo "No tabs open."
  fi
}

cmd_search_root() {
  if [ $# -eq 0 ]; then
    if [ -f "$SEARCH_ROOT_FILE" ]; then
      cat "$SEARCH_ROOT_FILE"
    else
      echo "$HOME"
    fi
    return 0
  fi
  local root
  root=$(cd "$1" 2>/dev/null && pwd || echo "$1")
  echo "$root" > "$SEARCH_ROOT_FILE"
  echo "Search root: $root"
}

# --- Dispatch ---

case "$1" in
  open)         shift; cmd_open "$@" ;;
  close)        shift; cmd_close "$@" ;;
  diff)         shift; cmd_diff "$@" ;;
  unwatch)      shift; cmd_unwatch "$@" ;;
  list)         cmd_list ;;
  search-root)  shift; cmd_search_root "$@" ;;
  _regen)       generate_tabbed_html force ;;
  *)            echo "Usage: fileview {open|close|diff|unwatch|list|search-root} [file ...]" >&2; exit 1 ;;
esac
