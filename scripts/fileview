@media (prefers-color-scheme: light) {
  body { color: #24292e; background: #ffffff; }
  .fv-tab-bar { background: #eaecef; border-bottom-color: #d0d7de; }
  .fv-tab { color: #6a737d; border-right-color: #d0d7de; }
