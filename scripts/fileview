  .fv-modal-input { background: #f6f8fa; border-bottom-color: #d0d7de; color: #24292e; }
  .fv-modal-input::placeholder { color: #9ca3af; }
  .fv-modal-item { color: #24292e; }
  .fv-modal-item:hover, .fv-modal-item.selected { background: #f6f8fa; }
  .fv-modal-item .fv-modal-fname { color: #24292e; }
  .fv-modal-item .fv-modal-fpath { color: #6a737d; }
  .fv-modal-overlay { background: rgba(0,0,0,0.2); }
  .fv-modal-item .fv-modal-content { color: #24292e; }
  .fv-modal-item .fv-modal-content mark { background: #fff3b0; color: #24292e; }
  .fv-modal-mode { border-bottom-color: #d0d7de; color: #9ca3af; }
}
.code-file-wrapper { border-radius: 8px; overflow: hidden; border: 1px solid #353b4a; margin: 0; }
.code-file-header { background: #2a2f3d; padding: 8px 14px; font-size: 11px; color: #8a90a0; font-family: -apple-system, sans-serif; display: flex; align-items: center; gap: 8px; border-bottom: 1px solid #353b4a; }
.code-file-header .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
.dot-red { background: #ff5f57; } .dot-yellow { background: #febc2e; } .dot-green { background: #28c840; }
