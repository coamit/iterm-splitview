  cursor: pointer;
  border-radius: 3px;
  width: 16px; height: 16px;
  text-align: center;
  vertical-align: middle;
}
.fv-tab-close:hover { color: #ff5f57; background: rgba(255,95,87,0.15); }
.fv-tab.active { color: #e8ecf0; background: #1f2430; }
.fv-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
