.diff-nav.visible { display: flex; }
.diff-nav button { width: 36px; height: 36px; border: 1px solid #353b4a; border-radius: 6px; background: #1f2430; color: #ccd0d4; font-size: 18px; cursor: pointer; display: flex; align-items: center; justify-content: center; opacity: 0.85; }
.diff-nav button:hover { background: #2a3040; opacity: 1; }
.diff-nav .diff-counter { font-size: 10px; color: #6a7080; text-align: center; user-select: none; }
/* Quick-open modal (Cmd+P) */
.fv-modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 300; }
.fv-modal-overlay.visible { display: flex; justify-content: center; padding-top: 60px; }
.fv-modal { width: 420px; max-height: 360px; background: #1f2430; border: 1px solid #353b4a; border-radius: 8px; box-shadow: 0 8px 32px rgba(0,0,0,0.5); display: flex; flex-direction: column; overflow: hidden; }
.fv-modal-input { background: #171b24; border: none; border-bottom: 1px solid #353b4a; padding: 12px 14px; font-size: 14px; color: #e8ecf0; outline: none; font-family: -apple-system, sans-serif; }
.fv-modal-input::placeholder { color: #4b5263; }
.fv-modal-list { list-style: none; overflow-y: auto; flex: 1; padding: 0; margin: 0; }
.fv-modal-item { padding: 8px 10px 8px 8px; cursor: pointer; font-size: 13px; font-family: -apple-system, sans-serif; color: #ccd0d4; display: flex; align-items: center; gap: 8px; border-left: 2px solid transparent; }
.fv-modal-item:hover, .fv-modal-item.selected { background: #2a3040; }
.fv-modal-item.selected { border-left-color: #73b8f0; }
.fv-modal-item .fv-modal-fname { color: #e8ecf0; }
.fv-modal-item .fv-modal-fpath { color: #4b5263; font-size: 11px; margin-left: auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 200px; direction: rtl; text-align: right; }
.fv-modal-item .fv-modal-line { color: #4b5263; font-size: 11px; font-family: "JetBrains Mono", monospace; }
.fv-modal-item .fv-modal-content { color: #ccd0d4; font-size: 12px; font-family: "JetBrains Mono", monospace; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
